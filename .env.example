# ==============================================================================
# Shipnote Environment Variables Example
# Copy this file to .env.local for local development.
# ==============================================================================

# --- Admin Authentication ---
# Secret token used to unlock /manage when token protection is active
MANAGE_TOKEN=your-manage-token-here

# --- UploadThing (File Uploads) ---
# API token from uploadthing.com for image and video uploads
UPLOADTHING_TOKEN=your-uploadthing-token-here

# --- Upstash / Vercel KV REST API (Used by Shipnote) ---
# REST endpoint for KV store (e.g. https://xxxx-xxxx-00000.upstash.io)
KV_REST_API_URL=https://your-kv-instance.upstash.io

# REST API token with read/write permissions
KV_REST_API_TOKEN=your-kv-rest-api-token-here

# --- Standard Vercel KV / Upstash Integration Variables ---
# Automatically populated by Vercel when connecting Upstash KV integration
KV_URL=rediss://default:your-token@your-kv-instance.upstash.io:6379
REDIS_URL=rediss://default:your-token@your-kv-instance.upstash.io:6379
KV_REST_API_READ_ONLY_TOKEN=your-kv-read-only-token-here
